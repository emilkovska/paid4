f.discount <- function(x, len.vx) {
# Must have names
if (length(x)>1 & (is.null(names(x)) & is.null(colnames(x)))) {
error.msg <- "discount_perc must be a named vector, e.g. c('1' = 2.5, '30' = 1.5)"
return(error.msg)
}
if (length(x)>1) {
when <- names(x)
x    <- x[order(when)]
v.x  <- rep(NA,101)
# First period
t0      <- 1:(as.numeric(names(x)[2])-1)
v.x[t0] <- x[1]
# Subsequent periods
for (i in 2:length(x)) {
t1      <- as.numeric(names(x)[i]):101
v.x[t1] <- x[i]
}
v.x <- v.x[1:len.vx]
} else {
v.x <- x/100
}
return(v.x)
}
gc()
#' Some countries have a different discount rate depending on the time horizon.
#' For example, France's discount rate is 2.5% for the first 29 years, and 1.5% after 30 or more years.
#'
#' @param x
#' @param len.vx
#'
#' @return
#' @export
#'
#' @examples
f.discount <- function(x, len.vx) {
# Must have names
if (length(x)>1 & (is.null(names(x)) & is.null(colnames(x)))) {
error.msg <- "discount_perc must be a named vector, e.g. c('1' = 2.5, '30' = 1.5)"
return(error.msg)
}
if (length(x)>1) {
when <- names(x)
x    <- x[order(when)]
v.x  <- rep(NA,101)
# First period
t0      <- 1:(as.numeric(names(x)[2])-1)
v.x[t0] <- x[1]
# Subsequent periods
for (i in 2:length(x)) {
t1      <- as.numeric(names(x)[i]):101
v.x[t1] <- x[i]
}
v.x <- v.x[1:len.vx]
} else {
v.x <- x/100
}
return(v.x)
}
