mean
psa = "PSA"
j = "HC"
ratio   <- ratios[[psa]][[j]]
r       <- ratio[,3:ncol(ratio)] # The first two columns are "sex" and "age"
View(r)
R <- ratios$Deterministic$HC
View(R)
t= 1
par1 <- r[,t]
par2 <- r[,t+5]
t(mapply(f.draw, par1, par2))
test <- array(t(mapply(f.draw, par1, par2)), dim = c(202,1,1000))
dim(test)
test[,,1:5]
apply(test,c(1,2), mean)
testmean <- apply(test,c(1,2), mean)
plot(R$mean_0, type = "l")
lines(testmean, col = "red")
testlower <- apply(test,c(1,2), quantile,probs = 0.025,na.rm=TRUE)
plot(R$lower_0, type = "l")
lines(testlower, col = "red")
View(r)
?mapply
f.draw <- function(N,par1,par2) {
return(exp(rnorm(N,mean = par1, sd = par2)))
}
t(mapply(f.draw, par1, par2, ))
t(mapply(f.draw, par1, par2 ))
par2
t(mapply(f.draw, par1, par2))
f.draw <- function(N,par1,par2) {
res <- exp(rnorm(N,mean = par1, sd = par2))
return(res)
}
f.draw <- function(par1,par2,N) {
res <- exp(rnorm(N,mean = par1, sd = par2))
return(res)
}
t(mapply(f.draw, par1, par2))
t(mapply(f.draw, par1, par2, N = 10))
t(mapply(f.draw, par1 = par1, par2 = par2, N = 10))
t(mapply(f.draw, par1 = par1, par2 = par2, N = 10))
t(mapply(f.draw, par1 = par1, par2 = par2, N = 10))
t(mapply(f.draw, par1 = par1, par2 = par2, N = 1))
plot(t(mapply(f.draw, par1 = par1, par2 = par2, N = 1)))
test <- t(mapply(f.draw, par1 = par1, par2 = par2, N = 1))
View(test)
plot(unlist(test))
